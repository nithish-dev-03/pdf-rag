# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
*.so
.python

# Virtual environments
.venv/
venv/
env/
ENV/

# Packaging and build output
build/
dist/
*.egg-info/
*.egg
.eggs/
site/
*.whl
*.tar.gz

# Test, lint and type-check caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pyre/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# Local configuration and secrets (never commit these)
.env
.env.*
!.env.example

# uv local state (uv.lock SHOULD be committed for applications)
.uv/
uv-cache/

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS metadata
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# Logs and temporary files
*.log
logs/
tmp/
.tmp/

# Application data (indexes, uploads, vector stores, etc.)
app/data/

