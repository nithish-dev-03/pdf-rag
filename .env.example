GOOGLE_API_KEY=
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/doc_analyser

# Source PDF for `ingest`. Relative paths resolve against the project root.
# Forward slashes work on Windows, macOS and Linux. Examples:
#   Linux/macOS: /home/me/docs/policy.pdf
#   Windows:     C:/Users/me/docs/policy.pdf
PDF_PATH=app/data/ms-leave-policy.pdf

# Number of chunks retrieved per question (top-k). Tune between 3 and 6; too
# low drops the answering chunk, too high dilutes the prompt.
RETRIEVAL_LIMIT=5
